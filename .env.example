# Salin file ini menjadi .env.local lalu isi nilainya. File .env* TIDAK boleh di-commit.
# Nilai diambil dari Firebase Console > Project settings > Your apps > SDK setup and configuration.
# Nilai konfigurasi web memang terlihat publik di aplikasi; perlindungannya dari rules, App Check,
# dan pembatasan API key. Proyek produksi hanya dipegang pemilik proyek (lihat CLAUDE.md bagian 7).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise): kunci situs dari Console > App Check > Apps.
# Kosongkan saat memakai Emulator. Untuk localhost isi VITE_FIREBASE_APPCHECK_DEBUG=true lalu
# daftarkan token debug yang tercetak di konsol browser ke Console App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG=

# Pengembangan lokal dengan Firebase Emulator (tanpa menyentuh proyek cloud):
#   firebase emulators:start --only auth,firestore,storage,functions --project demo-imigrasi
# lalu isi VITE_FIREBASE_EMULATOR=true dan VITE_FIREBASE_PROJECT_ID=demo-imigrasi.
VITE_FIREBASE_EMULATOR=
