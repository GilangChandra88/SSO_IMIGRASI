# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.
# Gunakan proyek Firebase DEV/latihan, bukan proyek produksi (lihat README).
# Nilai diambil dari Firebase Console > Project settings > Your apps > SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Nama database Firestore. Kosongkan/hapus baris ini untuk memakai "imigrasi" (nilai bawaan).
# Isi "(default)" bila proyek dev Anda memakai database default.
VITE_FIREBASE_DATABASE_ID=imigrasi
