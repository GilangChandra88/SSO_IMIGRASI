# Salin file ini menjadi .env.local lalu isi nilainya. File .env* TIDAK boleh di-commit (kecuali
# .env.emulator, yang hanya berisi nilai pura-pura untuk Emulator).
# Nilai diambil dari Firebase Console > Project settings > Your apps > SDK setup and configuration.
# Nilai konfigurasi web memang terlihat publik di aplikasi; perlindungannya dari rules, App Check,
# dan pembatasan API key. Proyek produksi hanya dipegang pemilik proyek (lihat CLAUDE.md bagian 7).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise): kunci situs dari Console > App Check > Apps.
# Kosongkan saat memakai Emulator. Untuk localhost isi VITE_FIREBASE_APPCHECK_DEBUG=true lalu
# daftarkan token debug yang tercetak di konsol browser ke Console App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG=

# Berkas mana dipakai perintah mana (lihat docs/pengembangan-lokal.md):
#   npm run dev:emulator   -> .env.emulator (nilai pura-pura, di-commit); Emulator dari `npm run emulator`
#   npm run dev            -> .env.development.local (proyek dev imigrasi-database, tidak di-commit)
#   npm run dev:produksi   -> .env.local (produksi)
# Biarkan kosong di .env.local dan .env.development.local.
VITE_FIREBASE_EMULATOR=
