{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npx prettier --write:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run lint:fix)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run build)",
      "PowerShell(npm run preview)",
      "PowerShell(npx prettier --write:*)",
      "PowerShell(npx eslint:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git switch:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git stash:*)",
      "__claude-auto-approve__",
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "TodoWrite(*)",
      "Task(*)",
      "NotebookEdit(*)",
      "Bash(ls -R hooks pages components utils ui services)",
      "Bash(cat -n hooks/useDokumenLpj.jsx)",
      "Bash(grep -n \"lpjGroupSubDone\\\\|lpjSingleStatus\\\\|stagesWithStatus\" -r .)",
      "Bash(sed -n 18,70p utils/lpjLogic.js)",
      "Bash(sed -n 295,480p utils/lpjLogic.js)",
      "Bash(grep -n \"isAdmin\\\\|isSuperAdmin\" context/AuthContext.jsx)",
      "Bash(sed -n 85,100p modules/e-persuratan/AppModule.jsx)",
      "Bash(head -12 modules/e-persuratan/lpj/ui/DocPreviewPopup.jsx modules/e-persuratan/lpj/components/LampiranViewer.jsx)",
      "PowerShell(Get-Process AgenScanner -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 800; Remove-Item Env:DOTNET_ROOT -ErrorAction SilentlyContinue; Start-Process \"C:\\\\APP_PROJEK\\\\SCANER APP\\\\agen-scanner-rilis\\\\AgenScanner.exe\"; Start-Sleep -Seconds 4; \\(Invoke-WebRequest -UseBasicParsing http://127.0.0.1:47800/status -Headers @{Origin='http://localhost:5173'}\\).Content)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin HEAD:main:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git branch -D:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "PowerShell(git push:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npm i:*)",
      "PowerShell(npm uninstall:*)",
      "PowerShell(Remove-Item *)",
      "Edit(/CLAUDE.md)",
      "Edit(src/components/**)",
      "Edit(!src/components/SuratPreview/**)",
      "Edit(/src/layouts/**)",
      "Edit(/src/utils/**)",
      "Edit(/src/config/**)",
      "Edit(/src/context/**)",
      "Edit(/src/App.jsx)",
      "Edit(/src/main.jsx)",
      "Edit(/src/index.css)",
      "Edit(/src/modules/e-persuratan/AppModule.jsx)",
      "Edit(/src/modules/e-persuratan/index.js)",
      "Edit(/package.json)",
      "Edit(/eslint.config.js)",
      "Edit(/vite.config.js)",
      "Edit(/firebase.json)",
      "Edit(/firestore.indexes.json)",
      "Edit(/vercel.json)",
      "Edit(/functions/**)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve'}))\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve', answer: 'yes'}))\""
          }
        ]
      }
    ]
  }
}
