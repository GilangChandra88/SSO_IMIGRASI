# Nilai PURA-PURA khusus Firebase Emulator (proyek demo-imigrasi). Tidak ada rahasia di sini,
# jadi berkas ini boleh di-commit. Jangan pernah mengisinya dengan nilai proyek sungguhan.
# Dipakai "npm run dev:emulator" (vite --mode emulator) dan menimpa nilai di .env.local.
# Panduan: docs/pengembangan-lokal.md
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-imigrasi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-imigrasi
VITE_FIREBASE_STORAGE_BUCKET=demo-imigrasi.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG=
